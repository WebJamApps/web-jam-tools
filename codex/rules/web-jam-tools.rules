# codex/rules/web-jam-tools.rules
#
# Codex execution policy rules for web-jam-tools (web-jam-tools#1142).
# Forbids raw git pushes, branch deletes, gh repo sync, and claude invocations.
# Prompts for gh api and deno task push --force-with-lease.
# Leaves plain deno task push and read-only commands untouched (allowed).
# Shared-config and --repo-dir forms can miss the force-with-lease prefix below;
# scripts/push.ts independently requires terminal confirmation for every force push
# and refuses noninteractive force pushes, including those unmatched forms.
#
# Known limit: a rule matches only the leading words of a command, so this file
# is a backstop for the plain and common wrapped forms. A git command carrying a
# global option before the subcommand (for example `git -C <path> ...`) is
# deliberately not matched here, by Josh's ruling of 2026-10-03, because the
# grammar has no wildcard and forbidding the prefix would also refuse harmless
# commands; those forms are decided by the push-guard hooks, which parse the command.

prefix_rule(pattern=["git", "push"], decision="forbidden")
prefix_rule(pattern=["git", "branch", "-D"], decision="forbidden")
prefix_rule(pattern=["git", "branch", "--delete"], decision="forbidden")
prefix_rule(pattern=["gh", "repo", "sync"], decision="forbidden")
prefix_rule(pattern=["claude"], decision="forbidden")

# Common wrappers.
prefix_rule(pattern=[["env", "command", "sudo"], "git", "push"], decision="forbidden")
prefix_rule(pattern=["/usr/bin/git", "push"], decision="forbidden")
prefix_rule(pattern=[["npx", "env", "command"], "claude"], decision="forbidden")

prefix_rule(pattern=["gh", "api"], decision="prompt")
prefix_rule(pattern=["deno", "task", "push", "--force-with-lease"], decision="prompt")
prefix_rule(pattern=[["env", "command"], "gh", "api"], decision="prompt")
prefix_rule(pattern=["/usr/bin/gh", "api"], decision="prompt")
