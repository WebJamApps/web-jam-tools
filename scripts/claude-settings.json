{
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/agent-alert.sh claude prompt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/agent-alert.sh claude finished"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "deno run --allow-read --allow-env $HOME/WebJamApps/web-jam-tools/scripts/session-load-report.ts"
          }
        ]
      }
    ]
  }
}
