{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/main/cli/schemas/config-file.v1.json",
  "version": "1.26.21",
  "tasks": {
    "queue": "deno run --allow-read --allow-write src/task-queue/cli.ts",
    "test": "deno test --allow-env --allow-run --allow-read --allow-write",
    "coverage": "rm -rf cov_profile && deno test --allow-env --allow-run --allow-read --allow-write --coverage=cov_profile && deno coverage cov_profile",
    "coverage:check": "bash scripts/coverage-check.sh",
    "check": "deno check src/ test/",
    "fmt": "deno fmt src/ test/",
    "fmt:check": "deno fmt --check src/ test/",
    "lint": "deno lint src/ test/",
    "audit": "bash scripts/audit.sh",
    "sast": "bash scripts/sast.sh",
    "scrape:gigs": "deno run -A src/gig-scraper/scrape_gigs.ts",
    "scrape:songs": "deno run -A src/gig-scraper/scrape_songs.ts",
    "list:buttons": "deno run -A src/gig-scraper/list_buttons.ts",
    "fetch:songs": "deno run --allow-net src/gig-scraper/fetch_api_songs.ts",
    "devotional": "deno run --allow-net --allow-env src/devotional/send_daily_devotional.ts",
    "outreach:advance": "deno run --allow-net --allow-env src/outreach-cron/advance_cadence.ts",
    "dropbox:link": "deno run --allow-net --allow-env src/dropbox-link/dropbox_link_cli.ts",
    "venue-contact:extract": "deno run -A src/venue-contact/cli.ts",
    "fix-labels:diff": "deno run --allow-run=gh --allow-read=skills/fix-labels/labels.yaml src/fix-labels/diff.ts",
    "fix-labels:milestone-diff": "deno run --allow-run=gh --allow-read=skills/fix-labels/labels.yaml src/fix-labels/milestone-diff.ts",
    "fix-labels:generate-model-labels": "deno run --allow-read=skills/fix-labels/labels.yaml --allow-write=skills/fix-labels/model-labels.json src/fix-labels/generate-model-labels.ts",
    "update:reaper": "bash scripts/reaper-update.sh",
    "monitor:uptime": "deno run --allow-net --allow-env src/uptime/cli.ts",
    "monitor:cron": "deno run --allow-net --allow-env src/uptime/cron.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/cli": "jsr:@std/cli@^1.0.0",
    "@std/yaml": "jsr:@std/yaml@^1.0.0",
    "cheerio": "npm:cheerio@^1.2.0",
    "playwright": "npm:playwright@^1.59.1"
  },
  "fmt": {
    "lineWidth": 100,
    "include": ["src/", "test/"],
    "exclude": ["src/gig-scraper/*.json"]
  },
  "lint": {
    "include": ["src/", "test/"],
    "exclude": ["src/gig-scraper/*.json"],
    "rules": { "tags": ["recommended"] }
  },
  "deploy": {
    "org": "webjamapps",
    "app": "web-jam-uptime",
    "entrypoint": "src/uptime/cron.ts",
    "exclude": [
      "test/",
      "docs/",
      "hooks/",
      "skills/",
      "scripts/",
      "cov_profile/",
      "src/gig-scraper/",
      "src/venue-contact/",
      "src/fix-labels/",
      "src/task-queue/",
      "src/dropbox-link/",
      "src/outreach-cron/"
    ]
  }
}





